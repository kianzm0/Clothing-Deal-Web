# Local Postgres example — swap for your actual connection string.
# If you don't have Postgres running locally, the fastest path is a
# free instance on Neon, Supabase, or Railway; all give you a
# ready-to-paste DATABASE_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/threadscout?schema=public"

# NextAuth — generate a real secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"
