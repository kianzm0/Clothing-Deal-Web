generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  T_SHIRT     @map("t-shirt")
  HOODIE      @map("hoodie")
  SWEATSHIRT  @map("sweatshirt")
  LONG_SLEEVE @map("long-sleeve")
}

enum InteractionAction {
  SAVE
  UNSAVE
  SKIP
  CLICK_OUT
}

model Interaction {
  id        String            @id @default(cuid())
  userId    String
  productId String
  action    InteractionAction
  reward    Float
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("interactions")
  @@index([userId])
}

model BanditWeights {
  userId    String   @id
  weights   Float[]
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bandit_weights")
}

model WatchlistItem {
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("watchlist_items")
}

model Preference {
  userId         String   @id
  sizes          String[]
  favoriteBrands String[]
  dislikedBrands String[]
  colors         String[]
  fits           String[]
  maxBudget      Float    @default(200)
  minDiscountPct Float    @default(0)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("preferences")
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String?
  passwordHash   String
  createdAt      DateTime        @default(now())
  interactions   Interaction[]
  banditWeights  BanditWeights?
  watchlistItems WatchlistItem[]
  preference     Preference?

  @@map("users")
}

model Product {
  id       String    @id
  name     String
  brand    String
  category Category
  colors   String[]
  sizes    String[]
  image    String
  offers   Offer[]

  @@map("products")
}

model Offer {
  id             String   @id @default(cuid())
  store          String
  price          Float
  originalPrice  Float
  shippingCost   Float
  sizesInStock   String[]
  lastUpdated    DateTime
  url            String
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("offers")
  @@index([productId])
}
